# Google Apps Script Web App URL
# Reemplazar con la URL de tu Web App desplegada en Apps Script
VITE_GAS_WEBAPP_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# Contraseña del admin para los tests e2e de Playwright.
# No tiene default: sin esto, `npx playwright test` se detiene con un mensaje claro.
# TEST_PASSWORD=
